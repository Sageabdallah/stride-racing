# ─────────────────────────────────────────────────────────────
# STRIDE — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database (Neon PostgreSQL — cloud-hosted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# The Racing API — https://theracingapi.com
RACING_API_USERNAME=your_racing_api_username
RACING_API_PASSWORD=your_racing_api_password

# Racing.com GraphQL API (sectional times collector)
RACING_COM_API_KEY=your_racing_com_api_key

# LLM provider (Groq + Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
LLM_ENABLED=true

# Consensus intelligence layer
TAVILY_API_KEY=your_tavily_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# Three-pillar convergence weights (non-secret tuning parameters)
STRIDE_MODEL_WEIGHT=0.50
CONSENSUS_WEIGHT=0.30
MARKET_SIGNAL_WEIGHT=0.20
CONSENSUS_LOCK_THRESHOLD=65
CONSENSUS_CONFIRM_THRESHOLD=45
MARKET_SIGNAL_THRESHOLD=60

# Feature flags — all default OFF; unset reproduces existing behaviour exactly.
# Pre-existing live flags, previously undocumented here:
STRIDE_CL_BLEND=false
STRIDE_PREDICTABILITY_GATE=false
STRIDE_ACCURACY_WEIGHTS=false
MC_ENABLE_SECTIONAL_FRANKING=false
MC_ENABLE_JOCKEY_EFFICIENCY=false

# Walk-forward harness (walk_forward_backtest.py)
STRIDE_WFB_RACE_SAFE_SPLIT=false
STRIDE_WFB_PRICE_AT_TIP=false

# Selection policies (selection_policy.py) — see that module's header before
# enabling: market mix contradicts the one-bet-per-race contract, and race
# filters raise strike rate by declining bets, which usually lowers ROI.
STRIDE_MIN_PROB_GATE=false
STRIDE_MIN_PROB_PCT=10
STRIDE_MARKET_MIX=false
STRIDE_MARKET_MIX_MODE=dutch
STRIDE_MARKET_MIX_BUNCHED_PCT=3
STRIDE_RACE_FILTER_MAIDEN=false
STRIDE_RACE_FILTER_BIG_FIELD=false
STRIDE_RACE_FILTER_SMALL_FIELD=false
STRIDE_RACE_FILTER_HEAVY_GOING=false
STRIDE_RACE_FILTER_MAX_FIELD=14
STRIDE_RACE_FILTER_MIN_FIELD=6

# Shadow staking (portfolio_risk.py / selection_ledger.py). Logs a fractional
# Kelly plan alongside the live 2u/1u/0u ladder; never becomes a real stake.
STRIDE_SHADOW_KELLY=false

# Selection ledger writer (selection_ledger.py). Requires
# migrations/selection_ledger.sql to have been applied.
STRIDE_LEDGER_WRITE=false

# Interaction-feature train/serve parity (feature_interactions.py). OFF keeps
# the inline inference formulas, including the barrier_x_pace_inv inversion.
# Enabling changes which horses are tipped — backtest before promoting.
STRIDE_INTERACTION_PARITY=false
