# ─────────────────────────────────────────────────────────────
# STRIDE — environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database (Neon PostgreSQL — cloud-hosted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Betfair Exchange API — verified setup in scripts/BETFAIR_KEYS_STATUS.md.
# App key is per-account (delayed vs live — see the status doc); username and
# password are the betfair.com.au login. Real values live in GitHub Actions
# repository secrets (same names) and your password manager — never in git.
BETFAIR_APP_KEY=your_betfair_app_key
BETFAIR_USERNAME=your_betfair_login_email
BETFAIR_PASSWORD=your_betfair_password

# Punting Form Starter API — replaced The Racing API for racecards/form/
# results (verified setup in PUNTINGFORM_MIGRATION.md). Auth is the apiKey
# query parameter; the real key lives in the GitHub Actions repository
# secret of the same name — never in git. Starter serves only ~31 days
# back (sliding), so daily ingestion must not lapse.
PUNTINGFORM_API_KEY=your_puntingform_api_key

# The Racing API — https://theracingapi.com (DEAD: ceased Australian
# coverage 2026-07; credentials return 401. Kept for historical modules.)
RACING_API_USERNAME=your_racing_api_username
RACING_API_PASSWORD=your_racing_api_password

# Racing.com GraphQL API (sectional times collector)
RACING_COM_API_KEY=your_racing_com_api_key

# LLM provider for form analysis and insights: groq (Llama 3.3 70B), anthropic
# (Claude on ANTHROPIC_API_KEY below; model via LLM_MODEL, default
# claude-sonnet-5) or ollama (local). Prove a change with
# server/python/llm_insight_proof.py before a run whose insights matter.
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
LLM_ENABLED=true

# Consensus intelligence layer
TAVILY_API_KEY=your_tavily_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key

# Three-pillar convergence weights (non-secret tuning parameters)
STRIDE_MODEL_WEIGHT=0.50
CONSENSUS_WEIGHT=0.30
MARKET_SIGNAL_WEIGHT=0.20
CONSENSUS_LOCK_THRESHOLD=65
CONSENSUS_CONFIRM_THRESHOLD=45
MARKET_SIGNAL_THRESHOLD=60

# Feature flags — all default OFF; unset reproduces existing behaviour exactly.

# Selection ledger (roi-roadmap task 01). Persist one row per race — bet or
# refused — with both the tip-time price and SP, settled net of commission.
# Measurement only: no model behaviour changes. Default OFF; set true in
# production so CLV is captured prospectively.
STRIDE_LEDGER_WRITE=false

# MC-time side-effect logging: prediction_audit, feature_snapshots and
# race_schedule rows written while scoring. Default ON. Two of the three are
# first-write-wins, so any run that scores a date BEFORE that date's real run
# must switch this off (the tips-proof job does so itself).
STRIDE_MC_AUDIT_WRITE=true

# Commission applied to net winnings in EV and settlement (win = (price-1) *
# (1 - rate), loss = -1). Default 0.08 (8% MBR). NSW/ACT tote deduction is 10%
# — set 0.10 when settling at tote prices in those states.
STRIDE_COMMISSION_RATE=0.08

# Pre-existing live flags, previously undocumented here:
STRIDE_CL_BLEND=false
STRIDE_PREDICTABILITY_GATE=false
STRIDE_ACCURACY_WEIGHTS=false
MC_ENABLE_SECTIONAL_FRANKING=false
MC_ENABLE_JOCKEY_EFFICIENCY=false

# Walk-forward harness (walk_forward_backtest.py)
STRIDE_WFB_RACE_SAFE_SPLIT=false
STRIDE_WFB_PRICE_AT_TIP=false

# Selection policies (selection_policy.py) — see that module's header before
# enabling: market mix contradicts the one-bet-per-race contract, and race
# filters raise strike rate by declining bets, which usually lowers ROI.
STRIDE_MIN_PROB_GATE=false
STRIDE_MIN_PROB_PCT=10
STRIDE_MARKET_MIX=false
STRIDE_MARKET_MIX_MODE=dutch
STRIDE_MARKET_MIX_BUNCHED_PCT=3
STRIDE_RACE_FILTER_MAIDEN=false
STRIDE_RACE_FILTER_BIG_FIELD=false
STRIDE_RACE_FILTER_SMALL_FIELD=false
STRIDE_RACE_FILTER_HEAVY_GOING=false
STRIDE_RACE_FILTER_MAX_FIELD=14
STRIDE_RACE_FILTER_MIN_FIELD=6

# Shadow staking (portfolio_risk.py / selection_ledger.py). Logs a fractional
# Kelly plan alongside the live 2u/1u/0u ladder; never becomes a real stake.
STRIDE_SHADOW_KELLY=false

# Selection ledger writer (selection_ledger.py). Requires
# migrations/selection_ledger.sql to have been applied.
STRIDE_LEDGER_WRITE=false

# Interaction-feature train/serve parity (feature_interactions.py). Default ON
# since the task-03 comparison (metro window 2026-03-04 -> 04-18, n=21,108):
# parity vs legacy delta exactly 0 on Brier/log-loss — the interaction is inert
# in the current artifact (importance 0.0; training never populates
# barrier_advantage), so the flip changes no live output today and removes the
# sign-flipped formula before the task-12 retrain makes the feature real.
# Set false to roll back to the legacy inline formulas (kept for one release).
STRIDE_INTERACTION_PARITY=true

# Serve-time NaN contract (roi-roadmap task 03, ml_model.prepare_features).
# OFF zero-fills every feature (legacy behaviour exactly). ON passes NaN
# through for the shared nan_contract.NAN_PRESERVE_SET columns (sectional/
# z-score features, trial_recency, runs_since_peak) so tree models route
# missingness exactly as in training. Default OFF for one shadow week, then ON.
STRIDE_SERVE_NAN_CONTRACT=false

# Market-movement features (roi-roadmap task 03/14). OFF serves the ~15
# movement columns as 0 in BOTH inference paths, matching training (they are
# zero-filled there). ON populates them from real movement — note the values
# are sourced post-tip-time; task 14 owns making them as-of. Default OFF.
STRIDE_MOVEMENT_FEATURES_LIVE=false

# Per-race renormalisation (roi-roadmap task 05, run_tips_pipeline). OFF keeps
# the legacy post-anchor winPercentage values, which do NOT sum to 100 within
# a race. ON rescales each field to sum to 100 exactly; edge/EV consume the
# renormalised value and tier transitions are logged, never silently dropped.
# Promote only after the shadow week (shadow_calibrator_compare.py) shows
# Brier/log-loss not worse.
STRIDE_RENORMALISE_FIELD=false

# Serve-time isotonic calibration of the ML ensemble (audit 2026-09-06 H1).
# OFF serves the base models' raw predict_proba — class-weight-inflated by
# scale_pos_weight=9 / is_unbalance / Balanced — into the 20-40% ML blend.
# ON passes each base model through the out-of-fold isotonic calibrator
# retrain_v2 fitted for it, and only when the artifact carries one for every
# base model present (older artifacts lost the CatBoost calibrator in
# pickling; retrain to get all three). Re-levels every published
# probability: promote only after a shadow-week A/B.
STRIDE_ML_APPLY_ISOTONIC=false

# Shared overround-corrected market probability in mc_api's standalone edge
# (roi-roadmap task 05). OFF keeps the legacy raw-implied edge (no de-vig);
# ON uses market_prob.true_market_prob_pct — the same helper the pipeline
# uses, so both entry points compute edge on one definition.
STRIDE_SHARED_MARKET_PROB=false

# Minimum usable rows for fitting a recorded-source calibrator
# (fit_calibrator.py --source mc_win_percentage_oof|final_prob). Below the
# gate the fit REFUSES — extend the audit logging and wait for coverage
# rather than fitting on a patched-together sample.
STRIDE_CAL_MIN_COVERAGE=500

# Consensus extraction model (consensus_agent.py). The id was hardcoded until
# 2026-08-02; claude-sonnet-4-20250514 retired 2026-06-15 and every extraction
# call 404'd for six weeks while the agent still exited 0 and wrote all-zero
# scores. preflight_extraction_model() now makes one 4-token call at startup and
# aborts (exit 3) if the id is dead or a parameter is rejected. Do not pass
# temperature: it is rejected with a 400 on claude-sonnet-5 and later.
ANTHROPIC_CONSENSUS_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Optional local paths — leave unset unless you need them
# ─────────────────────────────────────────────────────────────

# A .env outside the repository, for a checkout whose root has none. The
# modules that read .env directly (retrain_v2, fetch_and_import_date,
# backfill_phase2, backtest_v2_metro, import_barrier_trials_to_db) try the
# repo root first and fall back to this. Until 2026-09 each of them carried a
# hardcoded path to one dev machine's Windows checkout, which resolved on no
# other machine.
# STRIDE_ENV_FILE=/absolute/path/to/.env

# Root of a local Betfair BASIC historical archive (the .bz2 files), used by
# build_betfair_mapping.py as the default for --data-dir. Not needed for
# --refresh-view-only.
# BETFAIR_HISTORICAL_DIR=/absolute/path/to/betfair_historical
